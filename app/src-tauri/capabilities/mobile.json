{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Main window on a phone or tablet (no self-update: a new APK or store update replaces the app)",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:default"
  ]
}
