{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window on a computer",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ]
}
